# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://expert:expert@localhost:5432/expert?schema=public"

# JWT Secret Key & Token Expiration
JWT_SECRET="your-super-secret-jwt-key-replace-in-production-2026"
JWT_EXPIRES_IN="8h"

# API Port & CORS Origin
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# Local File Storage Fallback Path
STORAGE_PATH="./uploads"

# MinIO / S3 Object Storage Settings
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="expert_minio"
MINIO_SECRET_KEY="replace-this-minio-secret"
